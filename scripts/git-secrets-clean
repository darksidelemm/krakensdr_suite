#!/bin/sh
#
# git clean filter: sanitize station secrets before file content reaches git.
#
# Wired to the settings/config JSON files via .gitattributes
# (filter=kraken-secrets); install.sh registers it per clone:
#   git config filter.kraken-secrets.clean  scripts/git-secrets-clean
#   git config filter.kraken-secrets.required true
#
# The WORKING file keeps its real values - only the blob that gets staged/
# committed is sanitized (stdin -> stdout). Zeroed fields:
#   krakenpro_key / web_mapper_key  -> ""
#   latitude / longitude            -> 0
#   static_location                 -> "0,0,0"
#
sed -E \
    -e 's/("krakenpro_key"[[:space:]]*:[[:space:]]*")[^"]*(")/\1\2/' \
    -e 's/("web_mapper_key"[[:space:]]*:[[:space:]]*")[^"]*(")/\1\2/' \
    -e 's/("latitude"[[:space:]]*:[[:space:]]*)-?[0-9][0-9.eE+-]*/\10/' \
    -e 's/("longitude"[[:space:]]*:[[:space:]]*)-?[0-9][0-9.eE+-]*/\10/' \
    -e 's/("static_location"[[:space:]]*:[[:space:]]*")[^"]*(")/\10,0,0\2/'
