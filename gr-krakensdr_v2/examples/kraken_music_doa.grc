options:
  parameters:
    author: KrakenRF Inc.
    catch_exceptions: 'True'
    category: '[GRC Hier Blocks]'
    cmake_opt: ''
    comment: ''
    copyright: 2026 KrakenRF Inc.
    description: KrakenSDR v2 MUSIC DoA
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: qt_gui
    hier_block_src_path: '.:'
    id: kraken_music_doa
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: prompt
    sizing_mode: fixed
    thread_safe_setters: ''
    title: KrakenSDR v2 MUSIC DoA
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 8]
    rotation: 0
    state: enabled

blocks:
- name: decim
  id: variable_qtgui_range
  parameters:
    comment: 'Runtime-adjustable: the FIRs run at full rate (decim=1) with taps

      tracking this value; the actual rate cut happens in keep_one_in_n,

      whose set_n works at runtime (a FIR''s decimation factor does not).'
    gui_hint: (1,0,1,2)
    label: Decimation
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: int
    start: '1'
    step: '1'
    stop: '48'
    value: '10'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [288, 12]
    rotation: 0
    state: enabled
- name: fir_taps
  id: variable
  parameters:
    comment: 'Anti-alias low-pass, tracks decim: cutoff 40% / transition 20%

      of the decimated output rate (decim=24 -> 40 kHz / 20 kHz)'
    value: firdes.low_pass(1.0, samp_rate, 0.4*samp_rate/decim, 0.2*samp_rate/decim)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 140.0]
    rotation: 0
    state: enabled
- name: freq
  id: variable_qtgui_range
  parameters:
    comment: Every change triggers a heimdall retune + recalibration cycle
    gui_hint: (0,0,1,3)
    label: Center Frequency [MHz]
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '24'
    step: '0.1'
    stop: '1766'
    value: '100.0'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [544, 12.0]
    rotation: 0
    state: 'true'
- name: gain
  id: variable_qtgui_range
  parameters:
    comment: ''
    gui_hint: (0,3,1,3)
    label: Gain [dB] (-1 = AGC)
    min_len: '200'
    orient: QtCore.Qt.Horizontal
    rangeType: float
    start: '-1'
    step: '0.1'
    stop: '49.6'
    value: '40.2'
    widget: counter_slider
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [736, 12]
    rotation: 0
    state: 'true'
- name: array_type
  id: variable_qtgui_chooser
  parameters:
    comment: Applied live - doa_music regenerates its steering vectors
    gui_hint: (1,4,1,2)
    label: Array Type
    label0: UCA
    label1: ULA
    num_opts: '2'
    option0: '"UCA"'
    option1: '"ULA"'
    type: string
    value: '"UCA"'
    widget: combo_box
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [552, 84.0]
    rotation: 0
    state: 'true'
- name: radius
  id: variable_qtgui_entry
  parameters:
    comment: Applied live - doa_music regenerates its steering vectors
    entry_signal: editingFinished
    gui_hint: (1,2,1,2)
    label: UCA Radius / ULA Spacing [m]
    type: real
    value: '0.25'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [424, 12.0]
    rotation: 0
    state: 'true'
- name: samp_rate
  id: variable
  parameters:
    comment: ''
    value: '2400000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [184, 12]
    rotation: 0
    state: enabled
- name: vec_len
  id: variable
  parameters:
    comment: ''
    value: '256'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate: [8, 212.0]
    rotation: 0
    state: enabled
